# 왜: 로컬 개발환경용 환경변수 예시. .env.local로 복사해서 실제 값을 채워 사용합니다.
# 사용법: cp .env.local.example .env.local && vi .env.local
# 주의: .env.local은 .gitignore에 포함되어 커밋되지 않습니다.

# ─── Docker Compose (docker-compose.local.yml) ───
MYSQL_ROOT_PASSWORD=localroot
MYSQL_PASSWORD=localpass
QDRANT_API_KEY=local-test-key

# ─── Spring Boot API (polytech-lms-api) ───
# application-local.yml 또는 환경변수로 사용
APP_DB_URL=jdbc:mysql://127.0.0.1:3306/lms?useSSL=false&allowPublicKeyRetrieval=true
MYSQL_USER=lms

# ─── AI / 외부 API (없어도 기본 기능 동작) ───
GOOGLE_API_KEY=
GEMINI_API_KEY=
QDRANT_COLLECTION=video_summary_vectors_gemini

# ─── 선택적 API 키 ───
KOSIS_CONSUMER_KEY=
KOSIS_CONSUMER_SECRET=
WORK24_AUTH_KEY=
JOBKOREA_API_KEY=
JOBKOREA_OEM_CODE=
STATISTICS_AI_API_KEY=
KOLLUS_ACCESS_TOKEN=
KOLLUS_SECURITY_KEY=
KOLLUS_CHANNEL_KEY=
KOLLUS_CLIENT_USER_ID=contentsummary
